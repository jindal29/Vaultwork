# ==============================================================================
# VAULTWORK ENVIRONMENT CONFIGURATION (PRODUCTION & DEVELOPMENT)
# ==============================================================================
# Copy this file to '.env' and fill in the values from your Supabase dashboard:
# https://supabase.com/dashboard/project/_/settings/api
#
# IMPORTANT SECURITY RULES:
# 1. Never commit your '.env' file or any file with real secrets to version control.
# 2. Only use the public / anon key (VITE_SUPABASE_ANON_KEY) in client-side code.
# 3. NEVER expose the service_role secret key in Vite or client applications.
# ==============================================================================

# Supabase Project REST / GraphQL URL
# Location: Project Settings -> Configuration -> API -> Project URL
# Example: https://xyzcompanyproject.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (JWT used by client browser requests subject to RLS)
# Location: Project Settings -> Configuration -> API -> Project API keys -> 'anon' / 'public'
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here
