# Vaultwork Environment Variables
# Copy this file to .env and insert your project credentials from https://supabase.com/dashboard

# Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase Public Anon Key (found in Project Settings > API)
VITE_SUPABASE_ANON_KEY=
